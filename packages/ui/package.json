{
  "name": "tizhi-agent-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "体制.agent 的 DeepSeek Harness Web UI 插件：情境入口面板 + 机关大院皮肤",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onlyLT/tizhi-agent.git",
    "directory": "packages/ui"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  }
}
